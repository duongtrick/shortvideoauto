generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  queued
  scraping
  scripting
  tts
  rendering
  uploading
  completed
  failed
}

enum CreditReason {
  render_reserved
  render_refunded
  subscription_grant
  bank_payment
  admin_adjustment
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  name                 String?
  passwordHash         String?
  emailVerified        DateTime?
  resetTokenHash       String?
  resetTokenExpiresAt  DateTime?
  role                 String                @default("user")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  jobs                 RenderJob[]
  videos               Video[]
  scheduledPosts       ScheduledPost[]
  inspirationExamples  InspirationExample[]
  creditLedger         CreditLedger[]
  subscriptions        Subscription[]
  payments             Payment[]
  auditLogs            AuditLog[]
  series               ContentSeries[]
  referrals            Referral[]
  affiliateCommissions AffiliateCommission[]
}

model InspirationExample {
  id          String   @id @default(cuid())
  userId      String
  platform    String
  sourceUrl   String
  title       String?
  hook        String?
  cta         String?
  templateKey String?
  notes       String?
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([platform, createdAt])
  @@index([templateKey, createdAt])
}

model ProductSource {
  id          String      @id @default(cuid())
  url         String
  host        String
  title       String?
  price       String?
  imageUrls   String[]
  description String?
  rating      String?
  raw         Json?
  createdAt   DateTime    @default(now())
  jobs        RenderJob[]
}

model VideoTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  config    Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContentSeries {
  id              String      @id @default(cuid())
  userId          String
  name            String
  niche           String
  cadence         String
  language        String      @default("vi-VN")
  platformTargets String[]
  templateKey     String?
  voice           String?
  defaultCta      String?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User        @relation(fields: [userId], references: [id])
  jobs            RenderJob[]

  @@index([userId, createdAt])
  @@index([isActive, updatedAt])
}

model RenderJob {
  id               String          @id @default(cuid())
  userId           String
  seriesId         String?
  productSourceId  String?
  status           JobStatus       @default(queued)
  sourceUrl        String
  selectedScriptId String?
  errorCode        String?
  errorMessage     String?
  attempts         Int             @default(0)
  creditHoldId     String?         @unique
  outputVideoId    String?         @unique
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User            @relation(fields: [userId], references: [id])
  series           ContentSeries?  @relation(fields: [seriesId], references: [id])
  productSource    ProductSource?  @relation(fields: [productSourceId], references: [id])
  scriptVariants   ScriptVariant[]
  creditHold       CreditLedger?   @relation("CreditHold", fields: [creditHoldId], references: [id])
  outputVideo      Video?          @relation(fields: [outputVideoId], references: [id])

  @@index([userId, createdAt])
  @@index([seriesId, createdAt])
  @@index([status, createdAt])
}

model ScriptVariant {
  id        String    @id @default(cuid())
  jobId     String
  angle     String
  content   String
  score     Int       @default(0)
  createdAt DateTime  @default(now())
  job       RenderJob @relation(fields: [jobId], references: [id])
}

model VoiceAsset {
  id         String   @id @default(cuid())
  provider   String
  voice      String
  language   String   @default("vi-VN")
  storageKey String
  durationMs Int?
  createdAt  DateTime @default(now())
}

model TTSProvider {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  config    Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AIProvider {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  config    Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Video {
  id             String                @id @default(cuid())
  userId         String
  storageKey     String                @unique
  publicSlug     String                @unique
  durationMs     Int?
  width          Int                   @default(1080)
  height         Int                   @default(1920)
  createdAt      DateTime              @default(now())
  user           User                  @relation(fields: [userId], references: [id])
  job            RenderJob?
  scheduledPosts ScheduledPost[]
  referrals      Referral[]
  commissions    AffiliateCommission[]
}

model ScheduledPost {
  id              String   @id @default(cuid())
  userId          String
  videoId         String
  platform        String
  title           String?
  caption         String?
  hashtags        String[]
  scheduledAt     DateTime
  status          String   @default("draft")
  manualChecklist Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])
  video           Video    @relation(fields: [videoId], references: [id])

  @@index([userId, scheduledAt])
  @@index([platform, status])
}

model Referral {
  id             String                @id @default(cuid())
  referrerUserId String
  code           String                @unique
  referredEmail  String?
  status         String                @default("clicked")
  createdAt      DateTime              @default(now())
  convertedAt    DateTime?
  referrer       User                  @relation(fields: [referrerUserId], references: [id])
  commissions    AffiliateCommission[]
  video          Video?                @relation(fields: [videoId], references: [id])
  videoId        String?

  @@index([referrerUserId, createdAt])
  @@index([status, createdAt])
}

model AffiliateCommission {
  id         String    @id @default(cuid())
  userId     String
  referralId String
  amount     Int
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  paidAt     DateTime?
  user       User      @relation(fields: [userId], references: [id])
  referral   Referral  @relation(fields: [referralId], references: [id])
  video      Video?    @relation(fields: [videoId], references: [id])
  videoId    String?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model CreditLedger {
  id        String       @id @default(cuid())
  userId    String
  delta     Int
  reason    CreditReason
  meta      Json?
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id])
  heldJob   RenderJob?   @relation("CreditHold")

  @@index([userId, createdAt])
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String
  provider         String
  providerId       String    @unique
  status           String
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id])
}

model Payment {
  id        String    @id @default(cuid())
  userId    String
  code      String    @unique
  amount    Int
  credits   Int
  status    String    @default("pending")
  bankTxnId String?   @unique
  matchedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model BillingEvent {
  id         String   @id @default(cuid())
  provider   String
  providerId String   @unique
  type       String
  payload    Json
  createdAt  DateTime @default(now())
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  group     String   @default("general")
  updatedAt DateTime @updatedAt

  @@index([group])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([entity, entityId])
}
